import Mathlib.ModelTheory.ElementaryMaps
import Mathlib.SetTheory.ZFC.Ordinal
import CriticalSpectrum

/-! The set-theoretic statement. Application is the union of the images of
the restrictions of the right operand to smaller ranks. The critical points
enumerated here belong to the algebra generated by application. -/

set_option autoImplicit false
universe u
namespace Gamma11.RankI3
open FirstOrder

inductive MembershipSymbol : Nat → Type where
  | mem : MembershipSymbol 2

def membershipLanguage : Language := ⟨fun _ => Empty, MembershipSymbol⟩

/-- The carrier of V_λ is exactly the sets of rank strictly below λ. -/
abbrev Rank (height : Ordinal.{u}) := {x : ZFSet.{u} // x.rank < height}

instance (height : Ordinal.{u}) : membershipLanguage.Structure (Rank height) where
  funMap s := nomatch s
  RelMap := fun {n} (s : MembershipSymbol n) => match s with
    | .mem => fun v => (v 0).val ∈ (v 1).val

abbrev Emb (height : Ordinal.{u}) := Rank height ↪ₑ[membershipLanguage] Rank height

def IsWitness {height : Ordinal.{u}} (j : Emb height) : Prop :=
  Order.IsSuccLimit height ∧ ∃ x, j x ≠ x

def I3 : Prop := ∃ (height : Ordinal.{u}) (j : Emb height), IsWitness j

abbrev Below (height : Ordinal.{u}) := Set.Iio height
noncomputable def point {height : Ordinal.{u}} (α : Below height) : Rank height :=
  ⟨α.val.toZFSet, α.val.rank_toZFSet.symm ▸ α.property⟩

abbrev Graph (height : Ordinal.{u}) := Rank height → Rank height → Prop
def graphOf {height : Ordinal.{u}} (j : Emb height) : Graph height := fun x y => j x = y

def Restriction {height : Ordinal.{u}} (B : Graph height) (α : Below height) (s : Rank height) : Prop :=
  ∀ p : ZFSet, p ∈ s.val ↔ ∃ x y : Rank height,
    x.val.rank < α.val ∧ B x y ∧ p = ZFSet.pair x.val y.val

def application {height : Ordinal.{u}} (A B : Graph height) : Graph height := fun x y =>
  ∃ (α : Below height) (s z : Rank height), Restriction B α s ∧ A s z ∧ ZFSet.pair x.val y.val ∈ z.val

inductive Generated {height : Ordinal.{u}} (j : Emb height) : Graph height → Prop where
  | generator : Generated j (graphOf j)
  | app {A B : Graph height} : Generated j A → Generated j B → Generated j (application A B)

def leftPower {height : Ordinal.{u}} (j : Emb height) : Nat → Graph height
  | 0 => fun x y => x = y
  | 1 => graphOf j
  | n + 2 => application (leftPower j (n + 1)) (graphOf j)

def IsCritical {height : Ordinal.{u}} (A : Graph height) (α : Below height) : Prop :=
  (∀ β : Below height, β < α → A (point β) (point β)) ∧
    ∃ β : Below height, α < β ∧ A (point α) (point β)

def Enumerates {height : Ordinal.{u}} (j : Emb height) (γ : Nat → Below height) : Prop :=
  StrictMono γ ∧ ∀ α, (∃ A, Generated j A ∧ IsCritical A α) ↔ ∃ n, γ n = α

/-- The requested equality for every actual I3 witness, with existence of the
enumeration included. This definition adds no axiom. -/
def EndpointStatement : Prop := ∀ {height : Ordinal.{u}} (j : Emb height), IsWitness j →
  ∃ γ, Enumerates j γ ∧ leftPower j 11 (point (γ 3)) (point (γ targetIndex))

/-- The finite quotient correspondence, uniform in the row, input and cut.
This is a proposition about j whose proof is a separate requirement. -/
structure FiniteCorrespondence {height : Ordinal.{u}} (j : Emb height) (γ : Nat → Below height) : Prop where
  enumerates : Enumerates j γ
  reads : ∀ a x, ∃ y, leftPower j a (point (γ x)) (point (γ y)) ∧
    ∀ m, entry m a (2 ^ x) = 0 ↔ m ≤ y

theorem firstRowUnbounded_of_correspondence {height : Ordinal.{u}} {j : Emb height} {γ : Nat → Below height}
    (h : FiniteCorrespondence j γ) : TableElement.FirstRowUnbounded := by
  intro x
  obtain ⟨y, _, cut⟩ := h.reads 1 x
  exact ⟨y + 1, fun hz => Nat.not_succ_le_self y ((cut _).mp hz)⟩

/-- Recover the actual value of a rank embedding from its finite quotient
correspondence and two tests at consecutive degrees. -/
theorem actual_image_of_target {height : Ordinal.{u}} {j : Emb height} {γ : Nat → Below height}
    (h : FiniteCorrespondence j γ) (hT : Target) :
    leftPower j 11 (point (γ 3)) (point (γ targetIndex)) := by
  obtain ⟨y, hy, cut⟩ := h.reads 11 3
  have hmin := (cut targetIndex).mp (row11_zero_through_target _ (Nat.le_refl _))
  have hmax : ¬ targetIndex + 1 ≤ y := fun hu =>
    (target_iff_nonzero.mp hT) ((cut _).mpr hu)
  have e : y = targetIndex := by omega
  exact e ▸ hy

end Gamma11.RankI3
